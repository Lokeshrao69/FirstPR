{
  "name": "firstpr",
  "version": "1.0.0",
  "description": "FirstPR - an open-source AI guide to your first contribution. Gemma 4 agent reasoning over Graphify codebase knowledge graphs.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
