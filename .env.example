# --- Option A (default): Gemma 4 through the Gemini API ---
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMMA_MODEL=gemma-4-31b-it
# GEMMA_MODEL=gemma-4-26b-a4b-it   # faster MoE variant

# --- Option B: any self-hosted open-weight model via an OpenAI-compatible server ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama / vLLM / llama.cpp / DigitalOcean inference
# OPENAI_MODEL=gemma4
# OPENAI_API_KEY=ollama

PORT=3000
